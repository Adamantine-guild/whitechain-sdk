# WhiteChain SDK Environment Configuration Example
# Copy this file to .env and fill in your values
# Do not commit .env to version control

# RPC Configuration
RPC_URL=https://rpc.your.network

# Contract Addresses
GRANT_CONTRACT_ADDRESS=0xGrantContract

# Account Configuration (for write operations)
PRIVATE_KEY=your_private_key_here
ACCOUNT_ADDRESS=your_account_address_here

# Chain Configuration
CHAIN_ID=1
CHAIN_NAME=mainnet

# Optional: Metadata URIs
METADATA_BASE_URI=ipfs://
