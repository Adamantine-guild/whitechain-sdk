{
  "name": "grantchain-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Minimal TypeScript SDK for GrantChain MVP using viem",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "grantchain",
    "sdk",
    "viem",
    "mvp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.3.1"
  }
}
